    </style>

    <style name="ShapeAppearance.SpotMe.RadiusXL" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.SpotMe.Radius2XL" parent="">
        <item name="cornerFamily">rounded</item>
