<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============ SHAPE APPEARANCES ============ -->
    <style name="ShapeAppearance.SpotMe.RadiusSM" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearance.SpotMe.RadiusMD" parent="">
        <item name="cornerFamily">rounded</item>
